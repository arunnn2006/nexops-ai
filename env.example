# Copy to .env (or run: python scripts/generate_env.py) and replace EVERY placeholder.
# .env is git-ignored. Never commit real values.

# --- Backend (read by the FastAPI app and Alembic) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXOPS_SECRET_KEY=change-me-generate-a-random-value-of-48-chars
# SQLite (no Docker needed):
NEXOPS_DATABASE_URL=sqlite:///./nexops.db
# PostgreSQL (docker compose): NEXOPS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nexops
NEXOPS_ACCESS_TOKEN_MINUTES=60
NEXOPS_CORS_ORIGINS=["http://localhost:5173"]
NEXOPS_LOG_LEVEL=INFO
NEXOPS_METRICS_ENABLED=true
# Recovery is simulated only. "simulated" is the only accepted value.
NEXOPS_RECOVERY_MODE=simulated
# Demo-only convenience for a single-admin walkthrough. Leave false normally.
NEXOPS_ALLOW_SELF_APPROVAL=false

# --- docker compose (deployment/docker-compose.yml) ---
POSTGRES_USER=nexops
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=nexops
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
